{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/.tsbuildinfo",

    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "resolveJsonModule": true,
    "noEmit": true,

    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
